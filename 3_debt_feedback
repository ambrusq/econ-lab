import matplotlib.pyplot as plt

debt = 100
PD = 1
years = 30

debt_history = [debt]

for year in range(years):
    feedback_interest = 0.03 + 0.001 * debt
    debt = debt * (1 + feedback_interest) + PD
    debt_history.append(debt)

print(debt_history)

